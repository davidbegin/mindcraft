{
    "name": "mindcraft",
    "type": "module",
    "engines": {
        "node": ">=22.15.0"
    },
    "dependencies": {
        "@anthropic-ai/sdk": "^0.17.1",
        "@cerebras/cerebras_cloud_sdk": "^1.46.0",
        "@cursor/sdk": "^1.0.26",
        "@effect/sql": "0.52.1",
        "@effect/sql-drizzle": "0.51.0",
        "@effect/sql-pg": "0.53.0",
        "@google/genai": "^1.15.0",
        "@huggingface/inference": "^2.8.1",
        "@mistralai/mistralai": "^1.1.0",
        "canvas": "^3.1.0",
        "cheerio": "^1.0.0",
        "drizzle-orm": "0.44.7",
        "effect": "3.22.1",
        "express": "^4.18.2",
        "google-translate-api-x": "^10.7.1",
        "groq-sdk": "^0.15.0",
        "minecraft-data": "^3.97.0",
        "mineflayer": "^4.33.0",
        "mineflayer-armor-manager": "^2.0.1",
        "mineflayer-auto-eat": "^3.3.6",
        "mineflayer-collectblock": "^1.4.1",
        "mineflayer-pathfinder": "^2.4.5",
        "mineflayer-pvp": "^1.3.2",
        "node-canvas-webgl": "^0.3.0",
        "open": "^10.2.0",
        "openai": "^4.4.0",
        "prismarine-item": "^1.15.0",
        "prismarine-viewer": "^1.32.0",
        "replicate": "^0.29.4",
        "ses": "^1.9.1",
        "socket.io": "^4.7.2",
        "socket.io-client": "^4.7.2",
        "three": "^0.128.0",
        "vec3": "^0.1.10",
        "yargs": "^17.7.2"
    },
    "overrides": {
        "canvas": "^3.1.0",
        "gl": "9.0.0-rc.10"
    },
    "scripts": {
        "postinstall": "patch-package",
        "start": "node main.js",
        "test": "node --test",
        "test:bun": "bun test test/colony_store.test.ts test/colony_store.integration.test.ts test/settings_schema.test.ts test/model_error.test.ts test/ipc_contracts.test.ts test/profile.test.ts",
        "typecheck": "tsc --noEmit -p tsconfig.json",
        "lint:types": "eslint \"src/**/*.ts\" \"test/**/*.test.ts\" drizzle.config.ts",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "drizzle-kit migrate",
        "db:push": "drizzle-kit push",
        "reinstall": "npm run clean:modules && npm install",
        "clean:modules": "node -e \"const fs=require('fs');const p=require('path');['node_modules','package-lock.json'].forEach(f=>{if(fs.existsSync(f)){if(fs.lstatSync(f).isDirectory()){fs.rmSync(f,{recursive:true,force:true});}else{fs.unlinkSync(f);}}});\""
    },
    "devDependencies": {
        "@effect/language-service": "0.87.2",
        "@eslint/js": "^9.13.0",
        "@types/bun": "1.3.14",
        "@types/node": "26.2.0",
        "drizzle-kit": "0.31.10",
        "eslint": "^9.13.0",
        "eslint-plugin-no-floating-promise": "^2.0.0",
        "globals": "^15.11.0",
        "patch-package": "^8.0.0",
        "pg": "8.23.0",
        "typescript-eslint": "8.66.0"
    }
}
